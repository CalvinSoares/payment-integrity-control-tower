{
  "name": "payment-integrity-control-tower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fixtures": "tsx src/cli/run-scenarios.ts",
    "api": "tsx src/cli/run-api.ts",
    "worker": "tsx src/cli/run-worker.ts",
    "db:migrate": "tsx src/cli/run-migrations.ts",
    "test": "vitest run",
    "test:db": "vitest run --no-file-parallelism tests/postgres-adapter.test.ts tests/postgres-events.test.ts tests/postgres-settlement.test.ts tests/postgres-api.test.ts tests/postgres-operations.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
